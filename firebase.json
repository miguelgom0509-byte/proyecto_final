{
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/react-app/**"
    ],
    "headers": [
      { "source": "**/*.@(jpeg|jpg|png|svg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}